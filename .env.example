# 复制为 .env 后填写密钥。已有 .env 时，只补需要的项，不要覆盖密钥。
# 启动时读取项目根目录 .env；终端环境变量优先。修改后需重启程序。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=1

# Milvus 的客户端地址，包含协议、主机和端口。
# 本机运行 Python、Docker 映射 19530 时使用以下值。
# 若 Python 也在同一个 Docker 网络中，应使用 Milvus 服务名。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=employee_knowledge_bge_small_zh_v15
# 启用 Milvus 认证时填写用户名:密码；未启用时留空。
MILVUS_TOKEN=
MILVUS_TIMEOUT_SECONDS=10

# Web 服务与 Vue 开发服务器；修改端口时同步调整代理和允许的来源。
API_HOST='127.0.0.1'
API_PORT=8000
API_SESSION_TTL_HOURS=8
API_COOKIE_SECURE=false
API_UPLOAD_MAX_MB=20
# 默认业务库；API 与 Worker 必须使用同一个绝对路径或同一项目下的相对路径。
API_DATABASE_PATH=data/employee_assistant.db
API_ALLOWED_ORIGINS='http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000'
FRONTEND_HOST='127.0.0.1'
FRONTEND_PORT=5173
FRONTEND_API_TARGET='http://127.0.0.1:8000'

# 知识检索：一条辅助改写（失败回退原文）、重排候选数、短片段相邻上下文。
RAG_QUERY_REWRITE_ENABLED=true
RAG_CANDIDATE_LIMIT=36
RAG_NEIGHBOR_CONTEXT_ENABLED=true
# CPU 本地重排批次；全部候选仍参与重排，允许 1–64。
RAG_RERANK_BATCH_SIZE=1
# 自然语言时间解释与当前会议室查询使用的时区。
APP_TIMEZONE=Asia/Shanghai

# 后台建库：API 与 Celery Worker 使用同一个 Redis 队列。
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_QUEUE=knowledge
# 本地模型根目录，其中应有 knowledge/models、knowledge/hf_cache。
# 留空时使用 API_DATABASE_PATH 所在目录；模拟库可复用主项目 data。
INGESTION_MODEL_ROOT=
# OCR 语言包目录，应包含 chi_sim.traineddata、eng.traineddata。
# 留空时优先使用业务数据目录下 knowledge/tessdata，再使用系统 Tesseract 配置。
OCR_TESSDATA_PATH=
# 单个任务最长执行秒数；生产 Worker 使用 prefork 池才能执行超时限制。
INGESTION_TIME_LIMIT_SECONDS=3600
